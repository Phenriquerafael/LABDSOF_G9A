@startuml p5-health-and-metrics
' BMC physical views - P5 health, metrics and the public status page.
' Checks and dashboards from ADR-004 and ADR-012; logs are owned by DEVOPS-02.
' Render: java -jar plantuml.jar -tsvg -tpng documents/diagrams/physical-views/p5-health-and-metrics.puml
!pragma layout elk
!theme plain
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 13
skinparam ArrowColor #475569
skinparam ArrowFontSize 11
skinparam ArrowFontColor #334155
skinparam node {
  BackgroundColor #FFFFFF
  BorderColor #64748B
  FontColor #0F172A
  FontSize 13
}
skinparam artifact {
  BackgroundColor #FFFFFF
  BorderColor #94A3B8
  FontColor #0F172A
  FontSize 12
}
skinparam rectangle {
  BackgroundColor #F8FAFC
  BorderColor #94A3B8
  FontColor #0F172A
  FontSize 13
}
top to bottom direction

node "Public /status page\nand role-filtered banner" as public #F1F5F9
node "Operator" as operator #F1F5F9

node "traefik\nhealthcheck before routing" as traefik #EFF6FF
node "gatus\ncapability checks · 30 days" as gatus #F0FDFA
node "prometheus\nscrapes /metrics · alerts" as prom #F0FDFA
node "grafana\noperator dashboard" as grafana #F0FDFA

rectangle "BMC services · readiness covers own database" as bmc #F8FAFC {
  artifact "issue · dispatch · notification\nActuator readiness, Micrometer" as b1
  artifact "ai-triage-web\nFlask health, prometheus_client" as b2
}

rectangle "Platform checks · rolled up into capabilities" as plat #F8FAFC {
  artifact "oauth2-proxy · /ready, /metrics" as p1
  artifact "rabbitmq · diagnostics ping, plugin" as p2
  artifact "keycloak · /health/ready on port 9000" as p3
  artifact "mysql · query-level check" as p4
  artifact "garage · admin GET /health" as p5
  artifact "mailpit · readyz" as p6
  artifact "calendar-sim · calendar sync capability" as p7
}

public --> traefik : GET /status/api
traefik --> gatus : /status/api
operator --> grafana : access open in demo
grafana --> prom : queries
prom ..> gatus : scrape
prom ..> traefik : scrape · network open (P-01)
prom ..> bmc : scrape /metrics
prom ..> p1 : scrape
prom ..> p2 : scrape
gatus --> bmc : readiness
gatus --> plat : platform checks
traefik --> bmc : readiness of issue, dispatch, notification

@enduml
