@startuml p2-edge-and-trust
' BMC physical views - P2 edge routing and trust boundaries.
' Routes and middlewares from ADR-004; authorisation from ADR-005.
' Render: java -jar plantuml.jar -tsvg -tpng documents/diagrams/physical-views/p2-edge-and-trust.puml
!pragma layout elk
!theme plain
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 13
skinparam ArrowColor #475569
skinparam ArrowFontSize 11
skinparam ArrowFontColor #334155
skinparam node {
  BackgroundColor #FFFFFF
  BorderColor #64748B
  FontColor #0F172A
  FontSize 13
}
skinparam component {
  BackgroundColor #EFF6FF
  BorderColor #2563EB
  FontColor #0F172A
  FontSize 13
}
skinparam artifact {
  BackgroundColor #FFFFFF
  BorderColor #94A3B8
  FontColor #0F172A
  FontSize 12
}
skinparam rectangle {
  BackgroundColor #F8FAFC
  BorderColor #94A3B8
  FontColor #0F172A
  FontSize 13
}
top to bottom direction

node "Browser or installed PWA\none origin · no CORS" as browser #F1F5F9

rectangle "Trust boundary 1 · internet → traefik" as tb1 #FEF2F2 {
  node "traefik container\nonly published ports 80 / 443" as traefik #EFF6FF {
    component "Router\nTLS terminates here" as router
    component "ForwardAuth\nno session → 401\nsession → Bearer token" as fa
    component "StripPrefix\nremoves /api/<service>" as strip
  }
  node "oauth2-proxy\nsession check · OIDC client" as o2p #EFF6FF
}

rectangle "Traefik routing surface" as dest #F8FAFC {
  rectangle "API services\nvalidated after ForwardAuth and StripPrefix" as apis #F0FDF4 {
    node "issue\nJWT · membership" as issue #F0FDF4
    node "dispatch\nJWT · assignment" as dispatch #F0FDF4
    node "notification\nJWT · inbox owner" as notification #F0FDF4
  }
  rectangle "Public · no API session" as pub #F8FAFC {
    artifact "/  and  /status  →  client (nginx)" as r1
    artifact "/status/api  →  gatus (JSON only)" as r2
    artifact "/oauth2/*  →  oauth2-proxy" as r3
    artifact "/auth/*  →  keycloak" as r4
  }
  rectangle "Never routed" as never #FEF2F2 {
    artifact "Gatus UI · Traefik API and dashboard" as n1
    artifact "Health, Actuator and /metrics endpoints" as n2
    artifact "AI /classify · simulator control" as n3
    artifact "RabbitMQ, Garage and Mailpit admin" as n4
    artifact "Grafana and Keycloak admin console" as n5
  }
}

browser --> router : HTTPS 443
router --> fa : /api/<service>/*
fa --> strip : session valid
fa ..> o2p : session check
traefik --> dest : routes by rule

@enduml
