@startuml p4-data-and-platform
' BMC physical views - P4 data stores and platform connections.
' One database per service (ADR-001); stores, SMTP and calendar from ADR-006/007/010.
' Render: java -jar plantuml.jar -tsvg -tpng documents/diagrams/physical-views/p4-data-and-platform.puml
!pragma layout elk
!theme plain
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 13
skinparam ArrowColor #475569
skinparam ArrowFontSize 11
skinparam ArrowFontColor #334155
skinparam node {
  BackgroundColor #FFFFFF
  BorderColor #64748B
  FontColor #0F172A
  FontSize 13
}
skinparam database {
  BackgroundColor #F5F3FF
  BorderColor #7C3AED
  FontColor #0F172A
  FontSize 13
}
skinparam artifact {
  BackgroundColor #FFFFFF
  BorderColor #7C3AED
  FontColor #0F172A
  FontSize 12
}
skinparam rectangle {
  BackgroundColor #F8FAFC
  BorderColor #94A3B8
  FontColor #0F172A
  FontSize 13
}
top to bottom direction

rectangle "Services · own database only, no shared schema" as svcs #F8FAFC {
  node "issue\nreports · issues · memberships\nattachments" as issue #F0FDF4
  node "dispatch\ninterventions · bookings\ncontractors" as dispatch #F0FDF4
  node "notification\ninbox · preferences\ndelivery log" as notification #F0FDF4
  node "backup job\nplacement open (P-03)" as backup #F1F5F9
}

rectangle "mysql · MySQL 8.4 LTS · one instance" as mysql #F5F3FF {
  database "issue\nowner: issue" as dbi
  database "dispatch\nowner: dispatch" as dbd
  database "notification\nowner: notification" as dbn
  database "keycloak\nowner: keycloak" as dbk
}

rectangle "garage · Garage 2.5 · S3 subset" as garage #F5F3FF {
  artifact "bmc-attachments\nreport photos" as ba
  artifact "bmc-backups\nMySQL dumps" as bb
}

node "keycloak\naccounts and credentials\nsends account email" as keycloak #FFFBEB
node "calendar-sim\nHTTP · Idempotency-Key" as sim #FFFBEB
node "mailpit\nSMTP capture · demo only" as mailpit #FFFBEB

issue --> dbi : JDBC
issue --> ba : S3
dispatch --> dbd : JDBC
dispatch --> sim : HTTP
notification --> dbn : JDBC
notification ..> keycloak : Admin API · view-users
notification --> mailpit : SMTP
keycloak --> dbk : JDBC
keycloak --> mailpit : SMTP
backup ..> mysql : dump
backup ..> bb : write

@enduml
