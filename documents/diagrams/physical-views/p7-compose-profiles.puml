@startuml p7-compose-profiles
' BMC physical views - P7 Compose profiles and rollout order.
' ADR-004 proposal for the first vertical slice; to decide at the team review (EN01-U1).
' Render: java -jar plantuml.jar -tsvg -tpng documents/diagrams/physical-views/p7-compose-profiles.puml
!pragma layout elk
!theme plain
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 13
skinparam ArrowColor #475569
skinparam ArrowFontSize 11
skinparam ArrowFontColor #334155
skinparam node {
  BackgroundColor #FFFFFF
  BorderColor #64748B
  FontColor #0F172A
  FontSize 13
}
skinparam rectangle {
  BackgroundColor #F8FAFC
  BorderColor #94A3B8
  FontColor #0F172A
  FontSize 13
}
top to bottom direction

rectangle "First · profile core · 8 containers" as core #F0FDFA {
  node "edge and sign-in\ntraefik · oauth2-proxy · keycloak" as c1 #EFF6FF
  node "data and messaging\nmysql · rabbitmq" as c2 #F5F3FF
  node "business and client\nissue · dispatch · client" as c3 #F0FDF4
}

rectangle "When the slice includes the step · no profile name yet" as slice #F8FAFC {
  node "AI triage\nai-triage-web + ai-triage-consumer\nreporting works without them (NFR-03)" as l1 #F0FDF4
  node "notification\nneeded as soon as US-10 is in the slice" as l2 #F0FDF4
  node "calendar-sim\nneeded when dispatch books a visit" as l3 #FFFBEB
}

rectangle "Later · own profiles" as later #F8FAFC {
  node "demo\nmailpit + synthetic realm users" as x1 #FFFBEB
  node "status (proposed name)\ngatus · /status page and banner" as x2 #F0FDFA
  node "observability\nprometheus + grafana" as x3 #F0FDFA
  node "storage (proposed name)\ngarage · before backup and restore" as x4 #F5F3FF
}

core --> slice : then
slice --> later : then

@enduml
