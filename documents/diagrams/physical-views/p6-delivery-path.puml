@startuml p6-delivery-path
' BMC physical views - P6 environments and delivery path.
' Proposed pipeline from ADR-004 and the DEVOPS-01 proposal (PR #40, open); nothing exists yet.
' Render: java -jar plantuml.jar -tsvg -tpng documents/diagrams/physical-views/p6-delivery-path.puml
!pragma layout elk
!theme plain
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 13
skinparam ArrowColor #475569
skinparam ArrowFontSize 11
skinparam ArrowFontColor #334155
skinparam node {
  BackgroundColor #FFFFFF
  BorderColor #64748B
  FontColor #0F172A
  FontSize 13
}
skinparam artifact {
  BackgroundColor #FFFFFF
  BorderColor #2563EB
  FontColor #0F172A
  FontSize 12
}
skinparam rectangle {
  BackgroundColor #F8FAFC
  BorderColor #94A3B8
  FontColor #0F172A
  FontSize 13
}
top to bottom direction

node "Developer laptop\nsame compose.yaml · smaller profile set" as laptop #F1F5F9

node "GitHub" as github #F8FAFC {
  node "Repository\nfeature/* → main\nrelease by a protected v* tag" as repo #EFF6FF
  rectangle "GitHub Actions · proposed stages" as ci #F8FAFC {
    artifact "1  Lint and unit tests" as s1
    artifact "2  Contract checks · buf lint, buf breaking" as s2
    artifact "3  Boundary tests · ArchUnit, import-linter, ESLint" as s3
    artifact "4  Integration tests · real MySQL 8.4, RabbitMQ" as s4
    artifact "5  Multi-arch build · amd64, arm64 · method open" as s5
  }
  node "GHCR\none image per app · built once, promoted by tag" as ghcr #F5F3FF
}

node "Demonstration host\ncompose pull · up -d · rollback by previous tag" as host #F1F5F9
node "Host or CI environment\nsecrets and .env · never in Git" as secrets #FFFBEB

laptop --> repo : push · pull request
repo --> s1
s1 --> s2
s2 --> s3
s3 --> s4
s4 --> s5
s5 --> ghcr : push tagged images
ghcr --> host : pull the same image
secrets --> host : injected at deploy

@enduml
