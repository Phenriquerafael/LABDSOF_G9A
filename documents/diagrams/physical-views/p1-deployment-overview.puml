@startuml p1-deployment-overview
' BMC physical views - P1 deployment overview.
' Proposed design from ADR-004; nothing is built or deployed.
' Render: java -jar plantuml.jar -tsvg -tpng documents/diagrams/physical-views/p1-deployment-overview.puml
!pragma layout elk
!theme plain
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 13
skinparam ArrowColor #475569
skinparam ArrowFontSize 11
skinparam ArrowFontColor #334155
skinparam node {
  BackgroundColor #FFFFFF
  BorderColor #64748B
  FontColor #0F172A
  FontSize 13
}
skinparam database {
  BackgroundColor #F5F3FF
  BorderColor #7C3AED
  FontColor #0F172A
  FontSize 13
}
skinparam queue {
  BackgroundColor #FFF7ED
  BorderColor #D97706
  FontColor #0F172A
  FontSize 13
}
skinparam cloud {
  BackgroundColor #F1F5F9
  BorderColor #475569
  FontColor #0F172A
  FontSize 13
}
top to bottom direction

node "User device\nbrowser or installed PWA" as device #F1F5F9

node "Demonstration host\none Docker host · Docker Engine + Compose\nlinux/amd64 or linux/arm64 (EN01-U3)" as host {
  node "edge network only" as net_edge #F8FAFF {
    node "traefik\nTraefik 3.7\npublishes 80 / 443" as traefik #EFF6FF
    node "oauth2-proxy\n7.15\nbrowser session" as o2p #EFF6FF
    node "client\nnginx · React build" as client #EFF6FF
  }
  node "edge + internal networks" as net_dual #F0FDFA {
    node "issue\nSpring Boot · Java 25" as issue #F0FDF4
    node "dispatch\nSpring Boot · Java 25" as dispatch #F0FDF4
    node "notification\nSpring Boot · Java 25" as notification #F0FDF4
    node "keycloak\nKeycloak 26.8" as keycloak #FFFBEB
    node "gatus\nGatus 5.37" as gatus #F0FDFA
  }
  node "internal network only" as net_int #F5F3FF {
    node "ai-triage-web\nFlask · Gunicorn" as aiweb #F0FDF4
    node "ai-triage-consumer\nsame image · consumer" as aicon #F0FDF4
    node "calendar-sim\nSpring Boot · in memory" as sim #FFFBEB
    queue "rabbitmq\nRabbitMQ 4.x" as rabbitmq
    database "mysql\nMySQL 8.4 LTS" as mysql
    node "garage\nGarage 2.5 · S3 subset" as garage #F5F3FF
    node "mailpit\nMailpit 1.32" as mailpit #FFFBEB
    node "prometheus\nPrometheus 3.x" as prom #F0FDFA
    node "grafana\nGrafana 13" as grafana #F0FDFA
  }
}

cloud "AI provider API\ncandidate: Gemini Flash (DEC-05)" as ai
cloud "GitHub Container Registry\nmulti-arch images" as ghcr
cloud "Off-host backup copy\nCloudflare R2 · optional" as r2

device --> traefik : HTTPS 443
traefik --> net_dual : routes · see P2
net_dual --> net_int : data · see P4
aicon --> ai : HTTPS · only egress needed
ghcr --> host : image pull
garage --> r2 : backup copy

@enduml
